RUST_LOG=info
# Additional logging options (file mode)...by default is stdout
# See docker-compose.yaml for more details
# LOG_MODE=file
# LOG_DATA_DIR=logs/
MONITOR_DATA_DIR=./data
# LOG_MAX_SIZE=1073741824
# METRICS_ENABLED=false

ETHEREUM_MAINNET_RPC_URL=
# Not yet configured - see CLAUDE.md.
# FILECOIN_MAINNET_RPC_URL=
ARBITRUM_ONE_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Severity routing (invariant-monitoring-spec.md §04). Severity comes from which
# invariant is threatened, not from transaction size, and the point of splitting the
# channels is that an alert in the critical channel should always mean something.
#
#   CRITICAL - an invariant that cannot break during legitimate operation
#              (custody solvency, future value conservation). Auto-pause eligible.
#   INFO     - routine protocol activity with no invariant attached: auto-rolls on
#              schedule, individual itayose, individual liquidations.
#
# Both fall back to SLACK_WEBHOOK_URL when unset, so the split can be adopted whenever
# the channels exist without a config change.
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_URL_CRITICAL=
SLACK_WEBHOOK_URL_INFO=
