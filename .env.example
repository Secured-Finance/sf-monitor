RUST_LOG=info
# Additional logging options (file mode)...by default is stdout
# See docker-compose.yaml for more details
# LOG_MODE=file
# LOG_DATA_DIR=logs/
MONITOR_DATA_DIR=./data
# LOG_MAX_SIZE=1073741824
# METRICS_ENABLED=false

ETHEREUM_MAINNET_RPC_URL=
ARBITRUM_ONE_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Filecoin reaches its RPC through adapters/filecoin_adapter.py rather than directly -
# Filecoin null rounds would otherwise stall the monitor permanently (see CLAUDE.md).
# The two URLs below are the *real upstream* endpoints, used by `npm run generate` and
# by the adapter itself. Production uses mainnet; development/staging use Calibration.
FILECOIN_MAINNET_RPC_URL=https://api.node.glif.io/rpc/v1
FILECOIN_CALIBRATION_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# What OZ Monitor and the Python trigger scripts talk to: the adapter on loopback, not
# the upstream above (config/networks/filecoin_*.json names this variable). Served by
# the `filecoin-adapter` service in docker-compose.yml, or the sidecar container in GKE.
FILECOIN_ADAPTER_URL=http://127.0.0.1:8547

# The adapter's own upstream - set it to whichever of the two URLs above matches SF_ENV.
# Kept separate from them so the adapter has exactly one endpoint and never has to guess
# which chain it is bridging.
FILECOIN_UPSTREAM_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# Which chain the adapter is bridging, and how stale a finalized watermark may be
# before it refuses to serve it. The cutoff must exceed the network's real finality lag:
# ~12 min on mainnet, but ~98 min on Calibration, so the two differ by a lot.
# mainnet:     FILECOIN_EXPECTED_CHAIN_ID=314     FILECOIN_MAX_FINALIZED_AGE_SECONDS=1800
# calibration: FILECOIN_EXPECTED_CHAIN_ID=314159  FILECOIN_MAX_FINALIZED_AGE_SECONDS=10800
FILECOIN_EXPECTED_CHAIN_ID=314159
FILECOIN_MAX_FINALIZED_AGE_SECONDS=10800

SLACK_WEBHOOK_URL=
